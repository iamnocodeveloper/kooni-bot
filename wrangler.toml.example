# KOONI — template de configuración para Cloudflare.
# El instalador (scripts/kooni-init.sh / kooni-init.ps1) genera tu wrangler.toml
# a partir de este archivo con tus valores (slug, IDs de D1/Vectorize, etc.).
# NO edites este archivo directamente para tu bot: corre el instalador.

name = "kooni-bot-{{BOT_SLUG}}"
main = "src/index.ts"
compatibility_date = "2026-05-01"
compatibility_flags = ["nodejs_compat"]

[ai]
binding = "AI"

[[durable_objects.bindings]]
name = "AGENT"
class_name = "SupportAgent"

[[migrations]]
tag = "v1"
new_sqlite_classes = ["SupportAgent"]

[[d1_databases]]
binding = "DB"
database_name = "kooni_db"
# Crea tu D1 con: wrangler d1 create kooni_db  →  pega aquí el id
database_id = "{{D1_DATABASE_ID}}"

[[vectorize]]
binding = "KB"
index_name = "kooni_kb"
# Crea tu índice con: wrangler vectorize create kooni_kb --dimensions=1024 --metric=cosine

[vars]
LLM_PROVIDER = "openai"               # 'anthropic' | 'openai' | 'xai'
OPENAI_API_BASE_URL = ""              # opcional: gateway (ej. api.aisa.one/v1)
BOT_NAME = "{{BOT_NAME}}"
BUSINESS_NAME = "{{BUSINESS_NAME}}"
BOT_LANGUAGE = "es"
BOT_TIER = "free"                     # 'free' | 'pro' — pro se activa con licencia en el panel
BUFFER_SECONDS = "15"
DASHBOARD_BASE_URL = "https://{{BOT_SLUG}}.workers.dev"
# Zernio (multicanal — IG/FB/TG/WhatsApp…): automatizaciones desde el panel /admin/automatizaciones.
# (las reglas se gestionan en el panel; aquí solo si quieres defaults por env)

# Secrets (wrangler secret put <NAME> — nunca en git):
#   ANTHROPIC_API_KEY | OPENAI_API_KEY | XAI_API_KEY   — llave de IA (al menos una)
#   DASHBOARD_PASSWORD          — HTTP Basic Auth del panel (/admin, user: admin)
#   KB_REINDEX_TOKEN            — protege POST /kb/reindex
#   TELEGRAM_BOT_TOKEN          — canal Telegram
#   ZERNIO_API_KEY              — canal Zernio (multicanal)
#   ZERNIO_WEBHOOK_SECRET       — firma de webhooks Zernio
#   LICENSE_MASTER_KEY          — opcional: firma de códigos Pro (uso interno del dueño)
#   OWNER_TELEGRAM_CHAT_ID      — avisos de handoff al dueño

[triggers]
crons = ["0 3 * * *"]  # purga nocturna y trabajos diarios
