# KOONI — template de configuración para Cloudflare.
# El instalador (npx kooni-bot init) genera tu wrangler.toml real a partir de
# este archivo, estampando valores ÚNICOS por instalación: worker/D1/Vectorize
# se namespacan con un uid de 6 caracteres para que dos bots en la MISMA cuenta
# de Cloudflare NUNCA compartan datos. NO edites este archivo para tu bot.

name = "kooni-bot-{{BOT_SLUG}}"
main = "src/index.ts"
compatibility_date = "2026-05-01"
compatibility_flags = ["nodejs_compat"]

[ai]
binding = "AI"

[[durable_objects.bindings]]
name = "AGENT"
class_name = "SupportAgent"

[[migrations]]
tag = "v1"
new_sqlite_classes = ["SupportAgent"]

[[d1_databases]]
binding = "DB"
database_name = "kooni_db"
# Crea tu D1 con: wrangler d1 create kooni_db  →  pega aquí el id
database_id = "{{D1_DATABASE_ID}}"

[[vectorize]]
binding = "KB"
index_name = "kooni_kb"
# Crea tu índice con: wrangler vectorize create kooni_kb --dimensions=1024 --metric=cosine

[vars]
LLM_PROVIDER = "openai"               # 'anthropic' | 'openai' | 'xai'
# IMPORTANTE: si tu OPENAI_API_KEY es de un GATEWAY (AIsa, OpenRouter, etc.) y
# NO de OpenAI directo (sk-proj-…), pega aquí la URL base del gateway — si no,
# el bot contestará "Algo falló de mi lado". Vacío = OpenAI directo.
#   AIsa:  https://api.aisa.one/v1
OPENAI_API_BASE_URL = ""              # opcional: gateway (ej. api.aisa.one/v1)
# BOT_INSTANCE_ID lo estampa el CLI con el uid de 6 chars; liga las licencias Pro
# a UNA instalación concreta (no lo edites a mano).
BOT_INSTANCE_ID = "{{BOT_INSTANCE_ID}}"
BOT_NAME = "{{BOT_NAME}}"
BUSINESS_NAME = "{{BUSINESS_NAME}}"
BOT_LANGUAGE = "es"
BOT_TIER = "free"                     # 'free' | 'pro' — pro se activa con licencia en el panel
BUFFER_SECONDS = "15"
DASHBOARD_BASE_URL = "https://{{BOT_SLUG}}.workers.dev"
# Reporte de uso al panel de licencias del dueño (kooni-licencias): el cron
# nocturno envía métricas agregadas + costos de IA a esta función (registrar-uso).
# Vacío = no se envía nada. El CLI del dueño lo estampa automáticamente.
USAGE_PUSH_URL = ""
# Token compartido de registro/uso (X-Kooni-Token) — lo estampa el CLI; debe
# coincidir con el secret REGISTER_TOKEN del panel de licencias del dueño.
KOONI_REGISTER_TOKEN = ""
# ── Marca blanca del panel /admin (revendedores) ──────────────────────────────
# Sin estas vars, el panel usa la identidad Kooni. Con ellas, un revendedor
# puede ofrecer el mismo bot con SU nombre, logo y colores (reseller white-label).
# BRAND_NAME = "Mi Agencia"
# BRAND_LOGO_URL = "https://midominio.com/logo.png"
# BRAND_PRIMARY = "#2dd4bf"
# BRAND_PRIMARY_SOFT = "rgba(45,212,191,.13)"
# BRAND_ACCENT2 = "#6ee7b7"
# BRAND_BG = "#0d1218"
# BRAND_PANEL = "#141b24"
# Zernio (multicanal — IG/FB/TG/WhatsApp…): automatizaciones desde el panel /admin/automatizaciones.
# (las reglas se gestionan en el panel; aquí solo si quieres defaults por env)

# Secrets (wrangler secret put <NAME> — nunca en git):
#   ANTHROPIC_API_KEY | OPENAI_API_KEY | XAI_API_KEY | MINIMAX_API_KEY   — llave de IA (al menos una)
#   DASHBOARD_PASSWORD          — HTTP Basic Auth del panel (/admin, user: admin)
#   KB_REINDEX_TOKEN            — protege POST /kb/reindex
#   TELEGRAM_BOT_TOKEN          — canal Telegram
#   ZERNIO_API_KEY              — canal Zernio (multicanal)
#   ZERNIO_WEBHOOK_SECRET       — firma de webhooks Zernio
#   LICENSE_PUBLIC_KEY          — opcional: clave pública Ed25519 para verificar códigos KOONI-PRO-V2-…
#                                 (sin esta var se usa la pública embebida por defecto en src/license.ts;
#                                 la privada NUNCA va en el worker — vive solo en el panel de licencias)
#   OWNER_TELEGRAM_CHAT_ID      — avisos de handoff al dueño

[triggers]
crons = ["0 3 * * *"]  # purga nocturna y trabajos diarios
